    {
      "parameters": {
        "jsCode": "// Runs before the new ticket is appended, so the current ticket is never included.\n// row_number comes from Google Sheets: higher = added later (newest).\nconst rows = $input.all()\n  .map(i => i.json)\n  .filter(r => r && r.row_number !== undefined && r.row_number !== null);\n\nrows.sort((a, b) => Number(b.row_number) - Number(a.row_number));\n\nconst recent_subjects = rows\n  .map(r => String(r.Subject ?? '').trim())\n  .filter(s => s.length > 0)\n  .slice(0, 5);\n\nreturn [{ json: { recent_subjects } }];"
      },
      "id": "71ce871d-4a15-46ce-b029-baba1acf619e",
