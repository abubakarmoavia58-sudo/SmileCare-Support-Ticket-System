    {
      "parameters": {
        "jsCode": "const output = $json.output ?? {};\n\nconst draft = output.draft;\nconst confidence = output.confidence;\n\nconst valid =\n    typeof draft === \"string\" &&\n    draft.trim().length > 0 &&\n    typeof confidence === \"number\" &&\n    confidence >= 0 &&\n    confidence <= 1;\n\nreturn [{\n    json: {\n        draft: typeof draft === \"string\" ? draft : \"\",\n        confidence: typeof confidence === \"number\" ? confidence : null,\n        valid,\n        error: valid ? \"\" : ($json.error ? \"AI Agent error: \" + (typeof $json.error === \"string\" ? $json.error : JSON.stringify($json.error)) : \"Invalid AI output: expected draft (string) and confidence (0-1)\")\n    }\n}];"
      },
