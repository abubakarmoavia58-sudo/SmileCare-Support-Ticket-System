        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"draft\": {\n      \"type\": \"string\"\n    },\n    \"confidence\": {\n      \"type\": \"number\",\n      \"minimum\": 0,\n      \"maximum\": 1\n    }\n  },\n  \"required\": [\n    \"draft\",\n    \"confidence\"\n  ],\n  \"additionalProperties\": false\n}"
      },
      "id": "b19bcae4-04d6-41ad-b46f-f8dd7fba302c",
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
